# Copied to /etc/vox2lrc.env on the server (root:worker, mode 0640). Never commit the real file.
# deploy.sh fills in any key missing from the server's file; secrets are generated there.
VOX2LRC_API_TOKEN=generate-with-openssl-rand-hex-32
VOX2LRC_CALLBACK_SECRET=generate-with-openssl-rand-hex-32
VOX2LRC_AUDIO_HOSTS=.r2.cloudflarestorage.com
VOX2LRC_CALLBACK_HOSTS=open.waveformkaraoke.com
# The app's reconcile endpoint, POSTed every 5 minutes by vox2lrc-reconcile.timer (empty = off).
VOX2LRC_RECONCILE_URL=https://open.waveformkaraoke.com/api/internal/reconcile
VOX2LRC_ENGINE=whistle
VOX2LRC_MAX_UPLOAD_MB=50
VOX2LRC_MAX_DURATION=900
VOX2LRC_MAX_QUEUE=20
